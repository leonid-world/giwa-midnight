pragma language_version >= 0.22 && <= 0.23;
import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

export struct EligibilityResult {
    eligible: Boolean;
    providerId: Uint<16>;
    policyVersion: Uint<16>;
}

struct FinancialProfile {
    annualRevenueKrw: Uint<64>;
    debtRatioBps: Uint<32>;
    overdueCount: Uint<16>;
}

// A company commitment is a pseudonymous, PIN-rotatable identifier derived
// from a secret that never leaves local private state. It is not a verified
// business registration number or a claim about a real-world company.
export new type CompanySecretKey = Bytes<32>;
export new type CompanyCommitment = Bytes<32>;
export new type AdminPublicKey = Bytes<32>;

constructor() {
    contractAdmin = disclose(deriveAdminPublicKey(getCompanySecret()));
}

// Only the commitment and the verified outcome are public. Raw financial
// values, the provider signature, and the company secret are witness data and
// are never inserted into ledger state.
export ledger eligibilityResults: Map<CompanyCommitment, EligibilityResult>;
export ledger contractAdmin: AdminPublicKey;
export ledger providers: Map<Uint<16>, JubjubPoint>;

witness getAttestedFinancialWitness(): [FinancialProfile, Schnorr_SchnorrSignature, Uint<16>];
witness getCompanySecret(): CompanySecretKey;

export pure circuit deriveCompanyCommitment(
    sk: CompanySecretKey,
    pin: Uint<16>
): CompanyCommitment {
    const pinBytes = persistentHash<Uint<16>>(pin);
    return persistentHash<[Bytes<27>, Bytes<32>, CompanySecretKey]>([
        "gasok:company:commitment:v1",
        pinBytes,
        sk
    ]) as CompanyCommitment;
}

export pure circuit deriveAdminPublicKey(sk: CompanySecretKey): AdminPublicKey {
    return persistentHash<[Bytes<17>, CompanySecretKey]>([
        "gasok:admin:pk:v1",
        sk
    ]) as AdminPublicKey;
}

// A successful call proves two separate facts:
// 1. a currently registered mock provider signed these exact private values
//    for this company commitment; and
// 2. those values were evaluated by policy version 1.
// An ineligible but correctly attested profile writes eligible=false. An
// invalid signature or unregistered provider writes no result at all.
export circuit verifyEligibility(secretPin: Uint<16>): [] {
    const companyCommitment = deriveCompanyCommitment(getCompanySecret(), secretPin);
    const disclosedCompanyCommitment = disclose(companyCommitment);
    const companyCommitmentHash = transientHash<Bytes<32>>(
        disclosedCompanyCommitment as Bytes<32>
    );

    const [eligible, providerId] = evaluateFinancialProfile(companyCommitmentHash);
    const result = EligibilityResult {
        eligible: eligible,
        providerId: providerId,
        policyVersion: 1,
    };

    eligibilityResults.insert(disclosedCompanyCommitment, disclose(result));
}

circuit evaluateFinancialProfile(companyCommitmentHash: Field): [Boolean, Uint<16>] {
    const [profile, signature, providerId] = getAttestedFinancialWitness();
    const disclosedProviderId = disclose(providerId);

    assert(providers.member(disclosedProviderId), "Attestation provider not registered");
    const providerPk = providers.lookup(disclosedProviderId);

    // The field order is part of the signed-message protocol and must match
    // the Mock Attestation API exactly.
    const msg: Vector<4, Field> = [
        profile.annualRevenueKrw as Field,
        profile.debtRatioBps as Field,
        profile.overdueCount as Field,
        companyCommitmentHash
    ];

    Schnorr_schnorrVerify<4>(msg, signature, providerPk);

    const eligible =
        profile.annualRevenueKrw >= 500000000 &&
        profile.debtRatioBps <= 20000 &&
        profile.overdueCount <= 1;

    return [eligible, disclosedProviderId];
}

export circuit registerProvider(providerId: Uint<16>, providerPk: JubjubPoint): [] {
    assert(contractAdmin == deriveAdminPublicKey(getCompanySecret()), "Only admin can register providers");
    providers.insert(disclose(providerId), disclose(providerPk));
}

export circuit removeProvider(providerId: Uint<16>): [] {
    assert(contractAdmin == deriveAdminPublicKey(getCompanySecret()), "Only admin can remove providers");
    assert(providers.member(disclose(providerId)), "Provider not found");
    providers.remove(disclose(providerId));
}

export circuit rotateAdmin(newAdmin: AdminPublicKey): [] {
    assert(contractAdmin == deriveAdminPublicKey(getCompanySecret()), "Only admin can rotate admin role");
    contractAdmin = disclose(newAdmin);
}

// Re-export schnorrChallenge so the local mock provider and tests can build
// signatures that the Compact circuit verifies identically.
export pure circuit schnorrChallenge(
    ann_x: Field, ann_y: Field,
    pk_x: Field, pk_y: Field,
    msg: Vector<4, Field>
): Field {
    return Schnorr_schnorrChallenge(ann_x, ann_y, pk_x, pk_y, msg);
}
